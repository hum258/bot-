# Meta WhatsApp Cloud API - fill these only after official setup
VERIFY_TOKEN=choose_a_long_random_value
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
GRAPH_API_VERSION=v23.0

# Gemini API - keep this key private; never commit your real .env file
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Voice transcription model: tiny is the lightest starting point
WHISPER_MODEL=tiny

SYSTEM_PROMPT=أنت مساعد ذكي عام. أجب بلغة المستخدم بوضوح، ولا تخترع المعلومات.
